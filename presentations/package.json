{
  "name": "presentations",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /presentations/ --out dist",
    "export:pdf": "slidev export --format pdf --output campus-events-progress.pdf",
    "export:pptx": "slidev export --format pptx --output campus-events-progress.pptx",
    "export:pptx-editable": "slidev export --format pptx-editable --output ./outputs/pptx/campus-events-editable.pptx",
    "export:all": "pnpm run build && pnpm run export:pdf && pnpm run export:pptx"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.63.0"
  }
}
